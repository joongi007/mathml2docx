include LICENSE README.md requirements.txt requirements-docs.txt mkdocs.yml
recursive-include docs *.md
recursive-include skills *.md *.py
recursive-include scripts *.py
recursive-include tests *.py *.html *.png
prune tests/__pycache__
include requirements-examples.txt
recursive-include examples *.py *.html *.json *.png
prune examples/output
recursive-include docs/assets *.pdf *.png
